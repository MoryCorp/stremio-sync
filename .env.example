# URL access token - all routes are under /{SITE_TOKEN}/
# Generate: openssl rand -hex 16
SITE_TOKEN=

# Admin bearer token for protected API routes
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# AES-256 encryption key for stored passwords (exactly 64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Server port (optional, default 3000)
PORT=3000
